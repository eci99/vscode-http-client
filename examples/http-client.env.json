{
  "$shared": {
    "user": "user",
    "pageSize": 10
  },
  "httpbin": {
    "baseUrl": "https://httpbin.org",
    "Security": {
      "Auth": {
        "azure-app-1": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Client ID": "{{azure-app-uuid-xxxx}}",
          "Client Secret": "{{azure-secret-xxxxx}}",
          "Scope": "https://org-dev.crm.dynamics.cn/.default",
          "Token URL": "https://login.partner.microsoftonline.cn/{{org-talent-guid-xxx}}/oauth2/v2.0/token",
          "Auth URL":  "https://login.partner.microsoftonline.cn/{{org-talent-guid-xxx}}/oauth2/v2.0/authorize"
        }
      }
    }
  },
  "local": {
    "baseUrl": "http://localhost:8080"
  }
}
