# Authentication. The password, API key and secrets come from http-client.private.env.json.

### Basic authentication – "user password" is Base64-encoded automatically
GET {{baseUrl}}/basic-auth/{{user}}/{{password}}
Authorization: Basic {{user}} {{password}}

> {%
  client.test("Authenticated", () => client.assert(response.body.authenticated === true));
%}

### Basic authentication with an already encoded value – sent unchanged
GET {{baseUrl}}/basic-auth/user/passwd
Authorization: Basic dXNlcjpwYXNzd2Q=

### Bearer token from a login (here: a token generated by the script)
# @name login
POST {{baseUrl}}/anything/login
Content-Type: application/json

{"user": "{{user}}", "password": "{{password}}"}

> {%
  // A real API would return a token; httpbin echoes the request, so one is generated here.
  client.global.set("token", "tok-" + crypto.sha256().updateWithText(response.body.json.user).digest().toHex().slice(0, 16));
%}

### Uses the token from the login
GET {{baseUrl}}/bearer
Authorization: Bearer {{token}}

> {%
  client.test("Token accepted", () => client.assert(response.status === 200));
%}

### API key in a header
GET {{baseUrl}}/headers
X-Api-Key: {{apiKey}}

### Signed JWT (HS256), created in a pre-request script
< {%
  const token = jwt.sign(
    { sub: request.environment.get("user"), role: "admin" },
    request.environment.get("jwtSecret"),
    { algorithm: "HS256", expiresIn: "15m", issuer: "http-client-examples", audience: "api" }
  );
  request.variables.set("jwt", token);
%}
GET {{baseUrl}}/bearer
Authorization: Bearer {{jwt}}

> {%
  const token = request.headers.findByName("Authorization").value().replace("Bearer ", "");
  const decoded = jwt.decode(token);
  client.log("header:", decoded.header);
  client.log("payload:", decoded.payload);
  client.test("JWT is valid", () => {
    const payload = jwt.verify(token, request.environment.get("jwtSecret"), { audience: "api", issuer: "http-client-examples" });
    client.assert(payload.role === "admin");
  });
%}
