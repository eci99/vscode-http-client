{
  "name": "HTTP Response",
  "scopeName": "source.http-client-response",
  "patterns": [
    { "match": "^###\\s*$", "name": "punctuation.separator.http-client keyword.control" },
    { "match": "^//\\s+✓.*$", "name": "markup.inserted.http-client" },
    { "match": "^//\\s+(✗|⚠).*$", "name": "markup.deleted.http-client invalid.illegal" },
    { "match": "^//.*$", "name": "comment.line.http-client" },
    {
      "match": "^(HTTP/[\\d.]+)\\s+(\\d{3})(.*)$",
      "captures": {
        "1": { "name": "constant.language.http-version.http-client" },
        "2": { "name": "constant.numeric.status.http-client" },
        "3": { "name": "string.unquoted.reason.http-client" }
      }
    },
    {
      "match": "^([\\w-]+)(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "entity.name.tag.header.http-client support.type.property-name" },
        "2": { "name": "punctuation.separator.key-value.http-client" },
        "3": { "name": "string.unquoted.header-value.http-client" }
      }
    },
    {
      "begin": "^(?=\\s*[\\[{])",
      "end": "^(?=###\\s*$)",
      "contentName": "meta.embedded.block.json",
      "patterns": [ { "include": "source.json" } ]
    },
    {
      "begin": "^(?=\\s*<[\\w?!])",
      "end": "^(?=###\\s*$)",
      "contentName": "meta.embedded.block.html",
      "patterns": [ { "include": "text.html.basic" } ]
    }
  ]
}
